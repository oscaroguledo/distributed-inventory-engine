POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
POSTGRES_URL=postgresql+asyncpg://inventory:inventory@localhost:5433/inventory
REDIS_URL=redis://localhost:6380/0
LOG_LEVEL=INFO
HOLD_TTL_SECONDS=900

# Host-side port mappings for docker-compose.yml — 5432/6379 are already
# taken locally by other services, 8000 is free but kept configurable too.
POSTGRES_PORT=5433
REDIS_PORT=6380
ORDER_API_PORT=8000
