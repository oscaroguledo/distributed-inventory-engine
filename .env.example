POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
POSTGRES_URL=postgresql+asyncpg://inventory:inventory@localhost:5433/inventory
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
REDIS_URL=redis://localhost:6380/0
LOG_LEVEL=INFO
HOLD_TTL_SECONDS=900
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=200
STREAM_INVENTORY_EVENTS=stream:inventory_events
CONSUMER_GROUP_INVENTORY_SYNC=inventory_sync_workers
SWEEP_CLAIM_TTL_SECONDS=30
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=1.0
RATE_LIMIT_TTL_SECONDS=60
WATCHDOG_POLL_INTERVAL_SECONDS=30
WATCHDOG_CONFIRM_PASSES=2

# Host-side port mappings for docker-compose.yml — 5432/6379 are already
# taken locally by other services, 8000 is free but kept configurable too.
POSTGRES_PORT=5433
REDIS_PORT=6380
ORDER_API_PORT=8000
